*.sqlite
*.sqlite3
*.db

# Uploads (if your app stores files locally)
uploads/
public/uploads/

# Secrets / keys
*.pem
*.key

# Optional lock files (uncomment if needed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml