.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
dist/
build/

# Runtime data
pids/
*.pid
*.pid.lock

# Coverage
coverage/

# Cache
.cache/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.sw?

# Temporary files
tmp/
temp/

